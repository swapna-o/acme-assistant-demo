{
  "name": "timeoff-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "eval": "tsx eval/runner.ts",
    "smoke": "tsx scripts/smoke.ts",
    "policy-check": "tsx scripts/policy-check.ts",
    "eval:routing": "tsx eval/runner.ts routing",
    "eval:access": "tsx eval/runner.ts access",
    "eval:library": "tsx eval/runner.ts library",
    "eval:agent": "tsx eval/runner.ts agent",
    "eval:safety": "tsx eval/runner.ts safety",
    "eval:flow": "tsx eval/runner.ts flow",
    "eval:manager": "tsx eval/runner.ts manager",
    "eval:hr": "tsx eval/runner.ts hr",
    "eval:leave": "tsx eval/runner.ts leave",
    "posteval": "python3 ../website/build_evals_page.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
